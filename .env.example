# Bắt buộc: chuỗi ngẫu nhiên dài để ký cookie phiên đăng nhập
SESSION_SECRET=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai-32-ky-tu

# Đường dẫn file SQLite (mặc định ./data/poco.db)
DATABASE_PATH=./data/poco.db

# ---------- Trợ lý AI (OCR hoá đơn + nhập bill bằng chat) ----------

# Cần cho OCR hoá đơn và nhập bill bằng chat. Không commit key vào git.
ANTHROPIC_API_KEY=

# Endpoint. Bỏ trống = https://api.anthropic.com
# Dán được cả ba dạng, app tự ghép thành .../v1/messages:
#   https://api.anthropic.com
#   https://ai-gateway.noi-bo/anthropic/v1
#   https://ai-gateway.noi-bo/anthropic/v1/messages
ANTHROPIC_BASE_URL=

# Tên model. Bỏ trống = claude-sonnet-4-5
# Gateway nội bộ thường đặt tên riêng (ví dụ claude-sonnet-4-5-v1) — điền đúng
# tên mà gateway nhận, nếu không sẽ nhận lỗi 404 hoặc 400 từ gateway.
ANTHROPIC_MODEL=

# Trần token đầu ra mỗi lần gọi. Bỏ trống = 2000, tối đa 64000.
ANTHROPIC_MAX_TOKENS=

# Cách gửi key: "x-api-key" (mặc định, giống API Anthropic) hoặc "bearer"
# cho gateway chỉ nhận header Authorization: Bearer <key>
ANTHROPIC_AUTH_STYLE=

# Header anthropic-version. Bỏ trống = 2023-06-01, hiếm khi cần đổi.
ANTHROPIC_VERSION=

# Chờ tối đa mỗi lời gọi, tính bằng ms. Bỏ trống = 90000 (90 giây).
# Đặt rộng vì dịch vụ trên gói miễn phí (Render, Fly, Railway) ngủ khi không ai
# dùng và cần tới một phút để thức lại — lần gọi đầu trong ngày sẽ rất chậm.
ANTHROPIC_TIMEOUT_MS=

# Đặt =1 để cho phép gọi endpoint http:// tới máy khác. Mặc định app chặn vì
# ảnh hoá đơn sẽ đi qua kết nối không mã hoá. Localhost luôn được phép.
ANTHROPIC_ALLOW_INSECURE_HTTP=

# ---------- Chứng chỉ CA nội bộ (KHÔNG khai ở file này) ----------
#
# Nếu AI báo lỗi SELF_SIGNED_CERT_IN_CHAIN hoặc DEPTH_ZERO_SELF_SIGNED_CERT thì
# cần trỏ Node tới chứng chỉ CA của tổ chức. Nhưng NODE_EXTRA_CA_CERTS phải đặt
# ở DÒNG LỆNH, viết vào .env hoàn toàn vô hiệu: Node đọc biến này lúc khởi động
# tiến trình, còn Next chỉ nạp .env sau đó (đã kiểm chứng).
#
#   NODE_EXTRA_CA_CERTS=/duong/dan/ca-noi-bo.pem npm run dev
#
# Tuyệt đối không dùng NODE_TLS_REJECT_UNAUTHORIZED=0 để đi đường tắt: nó tắt
# kiểm tra chứng chỉ cho MỌI kết nối của app, kể cả lên Google Drive, nên ai
# chen được vào giữa cũng đọc và sửa được dữ liệu bill.

# Bảo vệ endpoint backup tự động /api/cron/backup
CRON_SECRET=

# Backup CSV hàng ngày lên Google Drive (dùng service account)
# Tạo service account, bật Drive API, share thư mục Drive cho email service account
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Dán private key, giữ nguyên \n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
